---
import T from '@gschz/astro-plugin-i18n/components/I18nText.astro';
import { translateAsync, getCurrentLanguage } from '@gschz/astro-plugin-i18n';

const lang = getCurrentLanguage(Astro.locals);
const snippet = await translateAsync('features:code.snippet', { lang });
---

<main class="container-custom py-12 flex flex-col gap-8">
  <header class="max-w-3xl">
    <T
      key="features:title"
      element="h1"
      class="text-4xl font-bold tracking-tight text-slate-900"
    />
    <T
      key="features:intro"
      element="p"
      class="mt-3 text-lg leading-relaxed text-slate-500"
    />
  </header>

  <section class="glass-card p-6 sm:p-8">
    <T
      key="features:fallbackExample.title"
      element="h2"
      class="text-xl font-semibold text-slate-900"
    />
    <p
      class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-500 sm:text-base"
    >
      <T key="features:fallbackExample.line" />
    </p>
    <p class="mt-2 text-xs text-amber-600 font-medium">
      <T key="features:fallbackExample.hint" />
    </p>
  </section>

  <section>
    <T
      key="features:headings.compare"
      element="h2"
      class="text-2xl font-bold tracking-tight text-slate-900"
    />
    <div
      class="mt-4 overflow-x-auto rounded-xl border border-slate-200/60 bg-white/70 shadow-sm"
    >
      <table class="min-w-full border-collapse text-left text-sm">
        <thead class="border-b border-slate-200 bg-slate-50/50">
          <tr>
            <th class="px-6 py-3.5 font-semibold text-slate-900"
              ><T key="features:compare.feature" /></th
            >
            <th class="px-6 py-3.5 font-semibold text-slate-900"
              ><T key="features:compare.native" /></th
            >
            <th class="px-6 py-3.5 font-semibold text-slate-900"
              ><T key="features:compare.plugin" /></th
            >
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200/60">
          <tr>
            <td class="px-6 py-4 font-medium text-slate-900"
              ><T key="features:rows.routing.feature" /></td
            >
            <td class="px-6 py-4 text-slate-500"
              ><T key="features:rows.routing.native" /></td
            >
            <td class="px-6 py-4 text-slate-500"
              ><T key="features:rows.routing.plugin" /></td
            >
          </tr>
          <tr>
            <td class="px-6 py-4 font-medium text-slate-900"
              ><T key="features:rows.ssr.feature" /></td
            >
            <td class="px-6 py-4 text-slate-500"
              ><T key="features:rows.ssr.native" /></td
            >
            <td class="px-6 py-4 text-slate-500"
              ><T key="features:rows.ssr.plugin" /></td
            >
          </tr>
          <tr>
            <td class="px-6 py-4 font-medium text-slate-900"
              ><T key="features:rows.bundles.feature" /></td
            >
            <td class="px-6 py-4 text-slate-500"
              ><T key="features:rows.bundles.native" /></td
            >
            <td class="px-6 py-4 text-slate-500"
              ><T key="features:rows.bundles.plugin" /></td
            >
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="grid gap-8 lg:grid-cols-2">
    <div class="glass-card p-6 sm:p-8">
      <T
        key="features:headings.list"
        element="h2"
        class="text-2xl font-bold tracking-tight text-slate-900"
      />
      <ul class="mt-4 space-y-2 text-slate-500 sm:text-base">
        <li class="flex items-start gap-2">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400"
          ></span>
          <T key="features:list.namespaces" />
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400"
          ></span>
          <T key="features:list.plural" />
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400"
          ></span>
          <T key="features:list.seo" />
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400"
          ></span>
          <T key="features:list.declarative" />
        </li>
        <li class="flex items-start gap-2">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-slate-400"
          ></span>
          <T key="features:list.audit" />
        </li>
      </ul>
    </div>
    <div>
      <T
        key="features:headings.code"
        element="h2"
        class="text-2xl font-bold tracking-tight text-slate-900"
      />
      <p class="mt-2 text-sm text-slate-400">
        <T key="features:code.caption" />
      </p>
      <pre class="code-block mt-4"><code>{snippet}</code></pre>
    </div>
  </section>
</main>
