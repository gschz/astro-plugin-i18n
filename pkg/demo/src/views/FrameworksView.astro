---
import T from '@gschz/astro-plugin-i18n/components/I18nText.astro';

import ReactCounter from '~/components/ui/react/Counter';
import VueCounter from '~/components/ui/vue/Counter.vue';
import SvelteCounter from '~/components/ui/svelte/Counter.svelte';
import SolidCounter from '~/components/ui/solid/Counter.tsx';

const reactSnippet = `import { useTranslation } from '@gschz/astro-plugin-i18n/react';

function Counter() {
  const { t, changeLanguage } = useTranslation();
  const [count, setCount] = useState(0);

  return (
    <div>
      <p>{t('frameworks:counter.items', { values: { count } })}</p>
      <button onClick={() => setCount(c => c + 1)}>+</button>
      <button onClick={() => changeLanguage('en')}>English</button>
    </div>
  );
}`;

const vueSnippet = `<script setup>
import { ref } from 'vue';
import { useI18n } from '@gschz/astro-plugin-i18n/vue';

const { t, changeLanguage } = useI18n();
const count = ref(0);
</script>

<template>
  <div>
    <p>{{ t('frameworks:counter.items', { values: { count } }) }}</p>
    <button @click="count++">+</button>
    <button @click="changeLanguage('en')">English</button>
  </div>
</template>`;

const svelteSnippet = `<script>
  import { t, changeLanguage } from '@gschz/astro-plugin-i18n/svelte';
  let count = 0;
</script>

<div>
  <p>{$t('frameworks:counter.items', { values: { count } })}</p>
  <button on:click={() => count++}>+</button>
  <button on:click={() => changeLanguage('en')}>English</button>
</div>



`;

const solidSnippet = `import { createSignal } from 'solid-js';
import { useI18n } from '@gschz/astro-plugin-i18n/solid';

function Counter() {
  const { t, changeLanguage } = useI18n();
  const [count, setCount] = createSignal(0);

  return (
    <div>
      <p>{t('frameworks:counter.items', { values: { count: count() } })}</p>
      <button onClick={() => setCount(c => c + 1)}>+</button>
      <button onClick={() => changeLanguage('en')}>English</button>
    </div>
  );
}`;
---

<main class="container-custom py-12 flex flex-col gap-8">
  <header class="max-w-3xl">
    <T
      key="frameworks:frameworks.title"
      element="h1"
      class="text-4xl font-bold tracking-tight text-slate-900"
    />
    <T
      key="frameworks:frameworks.description"
      element="p"
      class="mt-3 text-lg leading-relaxed text-slate-500"
    />
  </header>

  <div class="grid gap-8 md:grid-cols-2">
    <section class="glass-card p-6 flex flex-col gap-4">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">React</h2>
      <ReactCounter client:only="react" />
      <div>
        <h3 class="text-sm font-semibold text-slate-500 mb-2">
          <T key="frameworks:code.react" />
        </h3>
        <pre class="code-block"><code>{reactSnippet}</code></pre>
      </div>
    </section>

    <section class="glass-card p-6 flex flex-col gap-4">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Svelte</h2>
      <SvelteCounter client:only="svelte" />
      <div>
        <h3 class="text-sm font-semibold text-slate-500 mb-2">
          <T key="frameworks:code.svelte" />
        </h3>
        <pre class="code-block"><code>{svelteSnippet}</code></pre>
      </div>
    </section>

    <section class="glass-card p-6 flex flex-col gap-4">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Vue</h2>
      <VueCounter client:only="vue" />
      <div>
        <h3 class="text-sm font-semibold text-slate-500 mb-2">
          <T key="frameworks:code.vue" />
        </h3>
        <pre class="code-block"><code>{vueSnippet}</code></pre>
      </div>
    </section>

    <section class="glass-card p-6 flex flex-col gap-4">
      <h2 class="text-2xl font-bold tracking-tight text-slate-900">Solid</h2>
      <SolidCounter client:only="solid-js" />
      <div>
        <h3 class="text-sm font-semibold text-slate-500 mb-2">
          <T key="frameworks:code.solid" />
        </h3>
        <pre class="code-block"><code>{solidSnippet}</code></pre>
      </div>
    </section>
  </div>
</main>
