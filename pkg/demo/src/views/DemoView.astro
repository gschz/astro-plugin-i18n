---
import T from '@gschz/astro-plugin-i18n/components/I18nText.astro';
import {
  getLocalizedPath,
  getCurrentLanguage,
  getConfig,
} from '@gschz/astro-plugin-i18n';
import InteractiveDemo from '~/components/ui/react/InteractiveDemo';
import Counter from '~/components/ui/react/InterpolationDemo';
import PluralDemo from '~/components/ui/react/PluralDemo';

const lang = getCurrentLanguage(Astro.locals);
const config = Astro.locals.i18n?.config || getConfig();
const [homeHere, homeEn, homePtBr] = [
  getLocalizedPath('/', lang, config),
  getLocalizedPath('/', 'en', config),
  getLocalizedPath('/', 'pt-BR', config),
];
---

<main class="container-custom py-12 flex flex-col gap-8">
  <section class="glass-card p-6 sm:p-8">
    <T
      key="routing.title"
      element="h2"
      class="text-2xl font-bold tracking-tight text-slate-900"
    />
    <T
      key="routing.body"
      element="p"
      class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500 sm:text-base"
    />
    <div class="mt-5 flex flex-wrap gap-3">
      <a class="btn-secondary" href={homeHere}><T key="routing.linkHome" /></a>
      <a class="btn-secondary" href={homeEn}><T key="routing.linkEnglish" /></a>
      <a class="btn-secondary" href={homePtBr}><T key="routing.linkBrazil" /></a
      >
    </div>
    <div class="mt-4">
      <T
        key="routing.currentPath"
        element="span"
        values={{ path: Astro.url.pathname }}
        class="inline-flex items-center rounded-lg border border-slate-200/60 bg-white/60 px-3 py-1.5 font-mono text-xs text-slate-500 sm:text-sm"
      />
    </div>
  </section>

  <section class="grid gap-6 md:grid-cols-2">
    <article class="glass-card p-6">
      <T
        key="sections.server.title"
        element="h2"
        class="text-xl font-bold tracking-tight text-slate-900"
      />
      <T
        key="sections.server.body"
        element="p"
        class="mt-3 text-sm leading-relaxed text-slate-500 sm:text-base"
      />
    </article>

    <article class="glass-card p-6">
      <T
        key="sections.variables.title"
        element="h2"
        class="text-xl font-bold tracking-tight text-slate-900"
      />
      <T
        key="greeting"
        element="p"
        values={{ name: 'Gera', count: 3 }}
        class="mt-3 text-sm leading-relaxed text-slate-500 sm:text-base"
      />
      <T
        key="notifications.count"
        element="p"
        values={{ count: 3 }}
        class="mt-2 text-sm leading-relaxed text-slate-500 sm:text-base"
      />
    </article>
  </section>

  <section class="glass-card p-6 sm:p-8">
    <T
      key="controls.title"
      element="h2"
      class="text-2xl font-bold tracking-tight text-slate-900"
    />
    <T
      key="controls.body"
      element="p"
      class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500 sm:text-base"
    />
    <div class="mt-5 flex flex-wrap gap-3">
      <button id="lang-es" class="btn-secondary" type="button">Español</button>
      <button id="lang-en" class="btn-secondary" type="button">English</button>
      <button id="lang-pt-br" class="btn-secondary" type="button"
        >Portuguese (Brazil)</button
      >
    </div>
    <div class="mt-4">
      <span
        id="client-status"
        class="inline-flex items-center rounded-lg border border-slate-200/60 bg-white/60 px-3 py-1.5 font-mono text-xs text-slate-500 sm:text-sm"
      >
      </span>
    </div>
  </section>

  <InteractiveDemo client:only="react" />
  <Counter client:only="react" />
  <PluralDemo client:only="react" />
</main>

<script>
  import { initDemoI18nControls } from '~/utils/i18n.client';

  initDemoI18nControls();
</script>
