---
import T from '@gschz/astro-plugin-i18n/components/I18nText.astro';
import type { I18nKey } from '~/types/i18n-types';
import type { ImageMetadata } from 'astro';

interface Props {
  titleKey: I18nKey;
  bodyKey: I18nKey;
  icon: ImageMetadata;
}

const { titleKey, bodyKey, icon } = Astro.props;
---

<article class="glass-card flex gap-4 p-6">
  <span
    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600"
    aria-hidden="true"
  >
    <img src={icon.src} alt="" class="h-6 w-6" loading="lazy" />
  </span>
  <div>
    <T
      key={titleKey}
      element="h3"
      class="text-lg font-semibold text-slate-900"
    />
    <T
      key={bodyKey}
      element="p"
      class="mt-1.5 text-sm leading-relaxed text-slate-500 sm:text-base"
    />
  </div>
</article>
