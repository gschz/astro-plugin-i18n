{
  "name": "@gschz/astro-plugin-i18n",
  "version": "1.3.11",
  "description": "Internationalization (i18n) plugin for Astro — SSR-first, reactive client updates, and locale-aware routing in one integration.",
  "type": "module",
  "author": "Gera Schz <gschz.git@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "browser": {
        "types": "./dist/client.d.mts",
        "import": "./dist/client.mjs"
      }
    },
    "./components/*.astro": "./dist/components/*.astro",
    "./components/*": {
      "import": "./dist/components/*.mjs",
      "types": "./dist/components/*.d.mts"
    },
    "./integration": {
      "import": "./dist/integration.mjs",
      "types": "./dist/integration.d.mts"
    },
    "./client": {
      "import": "./dist/client.mjs",
      "types": "./dist/client.d.mts"
    },
    "./middleware-entrypoint": {
      "import": "./dist/middleware-entrypoint.mjs",
      "types": "./dist/middleware-entrypoint.d.mts"
    },
    "./schema": {
      "import": "./dist/schema.mjs",
      "types": "./dist/schema.d.mts"
    },
    "./react": {
      "import": "./dist/react/index.mjs",
      "types": "./dist/react/index.d.mts"
    },
    "./vue": {
      "import": "./dist/vue/index.mjs",
      "types": "./dist/vue/index.d.mts"
    },
    "./svelte": {
      "import": "./dist/svelte/index.mjs",
      "types": "./dist/svelte/index.d.mts"
    },
    "./solid": {
      "import": "./dist/solid/index.mjs",
      "types": "./dist/solid/index.d.mts"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "workspaces": [
    "pkg/*"
  ],
  "scripts": {
    "rm:dist": "bun run scripts/rm-dist.ts",
    "build": "bun run rm:dist && tsdown && bun run build:cp-astro && bun run build:fix-imports",
    "build:cp-astro": "bun run scripts/cp-astro.ts",
    "build:fix-imports": "bun run scripts/fix-astro-imports.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check && tsc --noEmit",
    "version:rc": "npm version prerelease --preid rc --no-git-tag-version",
    "publish": "bun publish --access public",
    "publish:next": "bun publish --access public --tag next",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "astro",
    "astro-plugin",
    "astro-integration",
    "i18n",
    "internationalization",
    "translation"
  ],
  "peerDependencies": {
    "astro": ">=6.3.2",
    "react": ">=19.2.6",
    "react-dom": ">=19.2.6",
    "vue": ">=3.5.32",
    "svelte": ">=5.55.4",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^5.0.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "astro": "^6.4.4",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "solid-js": "^1.9.13",
    "svelte": "^5.56.1",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue": "^3.5.35"
  },
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "https://github.com/gschz/astro-plugin-i18n"
  },
  "bugs": {
    "url": "https://github.com/gschz/astro-plugin-i18n/issues"
  },
  "homepage": "https://github.com/gschz/astro-plugin-i18n#readme",
  "publishConfig": {
    "access": "public"
  }
}
